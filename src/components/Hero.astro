---
import { useTranslations, type Lang } from '../i18n/translations';

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
---

<section class="hero">
  <h2 class="hero-title">{t('heroTitle')}</h2>
  <p class="hero-intro">{t('heroIntro')}</p>
</section>

<style>
  .hero {
    padding: 1.2rem 0 2rem;
    border-bottom: 1px solid var(--border-color);
    margin-bottom: 1.5rem;
  }
  .hero-title {
    margin: 0 0 0.8rem;
    font-size: clamp(1.5rem, 1rem + 2vw, 2.2rem);
    line-height: 1.2;
    color: var(--font-color-highlight);
  }
  .hero-intro {
    margin: 0;
    max-width: 46rem;
    line-height: 1.6;
  }
</style>
